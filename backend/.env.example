# ===== Máy chủ =====
PORT=4000
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# DB_FILE=./data/app.db
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES=30d

# ===== Tài khoản quản trị (tạo khi chạy npm run seed) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== Gửi OTP =====
# Để trống SMTP/SMS ở môi trường dev: mã OTP in ra console và trả về trong response (EXPOSE_DEV_OTP).
EXPOSE_DEV_OTP=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bé Tô Màu <no-reply@example.com>"
SMS_API_URL=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=

# ===== Đăng nhập Google (người dùng ≥ 13 tuổi) =====
GOOGLE_CLIENT_ID=

# ===== Thanh toán =====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Cho phép "thanh toán giả lập" khi cổng chưa cấu hình. LUÔN tắt ở production.
PAYMENT_MOCK=true

# ===== Đấu trường =====
ARENA_DURATION_SEC=600
ARENA_LOBBY_WAIT_SEC=60
ARENA_MIN_PLAYERS=2
# Khung giờ ghép ngẫu nhiên (giờ VN). Trống = luôn mở. Ví dụ: 08:00-11:00,14:00-21:00
ARENA_SLOTS=
